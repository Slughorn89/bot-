# --- Giełda (klucze tylko do odczytu wystarczą w trybie DRY_RUN) ---
EXCHANGE=binance
API_KEY=
API_SECRET=

# --- Handel ---
TRADING_PAIR=BTC/USDT
TIMEFRAME=1h
DRY_RUN=true
# MA_CROSSOVER | RSI | MACD | OPTIMIZED (parametry z optimize.py, zalecane)
STRATEGY=OPTIMIZED
BEST_PARAMS_FILE=best_params.json
POLL_SECONDS=30

# --- Ryzyko ---
RISK_PER_TRADE=0.02     # OPTIMIZED: strata przy stopie = 2% kapitału
MAX_ALLOC=0.5           # OPTIMIZED: max 50% kapitału w jednej pozycji (taka sama wartość jak --max-alloc w optimize.py)
MAX_POSITION_SIZE=0.1   # strategie klasyczne
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_OPEN_TRADES=3

# --- Wieloryby: off | alert (tylko log) | filter (blokuje BUY gdy wieloryby sprzedają) ---
WHALE_MODE=filter
WHALE_MIN_USD=1000000          # alert dla pojedynczej transakcji/pozycji >= tej kwoty
WHALE_FLOW_MIN_USD=100000      # transakcje >= tej kwoty liczą się do przepływu
WHALE_POLL_SECONDS=30
WHALE_BLOCK_SCORE=0.35         # BUY blokowany gdy wynik <= -0.35
WHALE_ADDRESSES=               # opcjonalnie: adresy Hyperliquid po przecinku

LOG_LEVEL=INFO
