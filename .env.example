# Exchange API Keys
EXCHANGE=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Trading Settings
TRADING_PAIR=BTC/USDT
TIMEFRAME=1h
DRY_RUN=true

# Risk Management
MAX_POSITION_SIZE=0.1       # Max % of balance per trade (10%)
STOP_LOSS_PCT=0.02          # Stop loss (2%)
TAKE_PROFIT_PCT=0.04        # Take profit (4%)
MAX_OPEN_TRADES=3

# Strategy
STRATEGY=MA_CROSSOVER       # Options: MA_CROSSOVER, RSI, MACD

# Logging
LOG_LEVEL=INFO
