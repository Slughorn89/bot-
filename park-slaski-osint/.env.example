# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore, nie commituj kluczy.

# Flickr: https://www.flickr.com/services/apps/create/apply/  (klucz niekomercyjny, bierzesz "Key", nie "Secret")
FLICKR_API_KEY=

# Mapillary: https://www.mapillary.com/dashboard/developers  ("Client Token", zaczyna się od MLY|)
MAPILLARY_ACCESS_TOKEN=

# YouTube Data API v3: Google Cloud Console, włącz API i utwórz klucz API
YOUTUBE_API_KEY=

# Windy Webcams API (opcjonalnie, do sprawdzenia kamer): https://api.windy.com/keys
WINDY_WEBCAMS_API_KEY=

# Twój e-mail do nagłówka User-Agent. Wikimedia wymaga kontaktu w UA, nigdzie indziej go nie wysyłamy.
CONTACT_EMAIL=

# Punkt odniesienia do liczenia odległości "lat,lon". Puste = domyślny 50.2795,18.9902 z config.py.
# Linia poleceń --point ma pierwszeństwo przed tym ustawieniem.
REFERENCE_POINT=

# Plik z trasą spaceru (GPX, TCX, GeoJSON albo .txt z punktami). Trzymaj go w private/.
ROUTE_FILE=

# ID lokalizacji Instagrama dla Parku Śląskiego, po przecinku (opcjonalnie, tylko do linków)
INSTAGRAM_LOCATION_IDS=

# Prostokąt przeszukiwania "min_lat,min_lon,max_lat,max_lon" (domyślnie cały park z zapasem)
# PARK_BBOX=50.2660,18.9600,50.3050,19.0150
