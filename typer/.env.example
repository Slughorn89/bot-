# Skopiuj do .env (plik .env nie trafia do repo)
# Baza: PostgreSQL w produkcji, SQLite domyslnie (prototyp)
# DATABASE_URL=postgresql+psycopg://typer:haslo@localhost:5432/typer
DATABASE_URL=sqlite:///data/typer.db
# OddsRelay: zamkniecia Betfair do CLV (cli.py betfair-close)
ODDSRELAY_KEY=
# The Odds API: snapshoty kursow w chwili typu i zamkniecia
ODDS_API_KEY=
# API-Football (API-Sports): sklady i kontuzje, 100 zapytan dziennie w planie darmowym
API_FOOTBALL_KEY=
# Telegram bot (raport rano i nowe typy): token od @BotFather, chat_id wpisuje sam `python cli.py telegram-setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# n8n (opcjonalnie): webhook dostaje ten sam raport jako JSON
N8N_WEBHOOK_URL=
# Telegram (oficjalne API klienta MTProto, my.telegram.org): tylko publiczne kanaly z config/sources.yaml
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Betfair Exchange: adapter domyslnie wylaczony, wlacz dopiero po potwierdzeniu legalnego dostepu
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
