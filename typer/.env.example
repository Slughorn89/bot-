# Skopiuj do .env (plik .env nie trafia do repo)
# Baza: PostgreSQL w produkcji, SQLite domyslnie (prototyp)
# DATABASE_URL=postgresql+psycopg://typer:haslo@localhost:5432/typer
DATABASE_URL=sqlite:///data/typer.db
# The Odds API: snapshoty kursow w chwili typu i zamkniecia
ODDS_API_KEY=
# n8n: webhook, ktory formatuje raport i wysyla na Telegram
N8N_WEBHOOK_URL=
# Opcjonalny komentarz LLM w raporcie dziennym: dowolny endpoint zgodny z OpenAI.
# Z All API Hub: skopiuj "Base URL" i klucz wybranego konta. Klucz z niskim limitem wydatkow.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
